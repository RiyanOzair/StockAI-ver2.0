{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://stockai-ver2-0.onrender.com/api/$1" },
    { "source": "/chat", "destination": "https://stockai-ver2-0.onrender.com/chat" },
    { "source": "/simulation/(.*)", "destination": "https://stockai-ver2-0.onrender.com/simulation/$1" },
    { "source": "/market/(.*)", "destination": "https://stockai-ver2-0.onrender.com/market/$1" },
    { "source": "/agents/(.*)", "destination": "https://stockai-ver2-0.onrender.com/agents/$1" },
    { "source": "/data/(.*)", "destination": "https://stockai-ver2-0.onrender.com/data/$1" },
    { "source": "/runs/(.*)", "destination": "https://stockai-ver2-0.onrender.com/runs/$1" },
    { "source": "/health", "destination": "https://stockai-ver2-0.onrender.com/health" },
    { "source": "/workspace/summary", "destination": "https://stockai-ver2-0.onrender.com/workspace/summary" }
  ],
  "routes": [
    { "src": "/app", "dest": "/index.html" },
    { "src": "/live-market", "dest": "/live-market.html" },
    { "src": "/workspace", "dest": "/workspace.html" },
    { "src": "/credits", "dest": "/credits.html" },
    { "src": "/", "dest": "/landing.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
